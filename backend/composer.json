{
    "name": "ecoride/backend",
    "description": "EcoRide Backend API",
    "type": "project",
    "require": {
        "php": "^8.1",
        "firebase/php-jwt": "^6.0",
        "phpmailer/phpmailer": "^6.8",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "EcoRide\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EcoRide\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}